            </div>

            <div class="space-y-0.5">
                <h2 id="active-mode-title" class="font-ewc text-2xl font-black text-slate-900 leading-none">Free Fire · Battle Royale</h2>
                <p class="text-xs font-bold text-slate-500">
                    41 matches · <span class="text-slate-600 font-extrabold">completed</span>
                </p>
            </div>
        </div>

        <!-- Filter Sub-Tabs Row -->
        <div class="flex items-center gap-6 border-b border-slate-200 overflow-x-auto no-scrollbar">
            <button id="tab-all-matches" onclick="switchPickemTab('all-matches')" class="tab-item">ALL MATCHES</button>
            <button id="tab-tournament" onclick="switchPickemTab('tournament')" class="tab-item">TOURNAMENT</button>
            <button id="tab-global" onclick="switchPickemTab('global')" class="tab-item active">GLOBAL</button>
            <button id="tab-recents" onclick="switchPickemTab('recents')" class="tab-item">RECENTS</button>
        </div>

        <!-- Dynamic Content Container -->
        <div id="tab-content-container">

            <!-- GLOBAL LEADERBOARD VIEW -->
            <div id="view-global" class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm">
                
                <!-- Table Header -->
                <div class="leaderboard-row bg-black text-white font-ewc text-[11px] font-bold tracking-wider uppercase">
                    <span>#</span>
                    <span>USER</span>
                    <span class="text-right">PICK'EM XP</span>
                </div>

                <!-- Dynamic Rows Injection Target -->
                <div id="leaderboard-rows-container"></div>

            </div>

            <!-- OTHER TAB PLACEHOLDERS -->
            <div id="view-all-matches" class="hidden space-y-3 p-6 bg-white rounded-2xl border border-slate-200 text-center">
                <span class="font-ewc text-lg font-bold text-slate-800">ALL MATCHES FEED</span>
                <p class="text-xs text-slate-500 font-semibold">Live predictions feed loading...</p>
            </div>

            <div id="view-tournament" class="hidden space-y-3 p-6 bg-white rounded-2xl border border-slate-200 text-center">
                <span class="font-ewc text-lg font-bold text-slate-800">TOURNAMENT WINNER PICKS</span>
                <p class="text-xs text-slate-500 font-semibold">Stage predictors loading...</p>
            </div>

            <div id="view-recents" class="hidden space-y-3 p-6 bg-white rounded-2xl border border-slate-200 text-center">
                <span class="font-ewc text-lg font-bold text-slate-800">RECENTLY COMPLETED MATCHES</span>
                <p class="text-xs text-slate-500 font-semibold">Awarded XP history loading...</p>
            </div>

        </div>

    </main>

