    <!-- Leaderboard Randomization & Logic Engine -->
    <script>
        let currentMode = 'br';

        // Pool of potential players for ranks 2 through 10
        const playerPool = [
            '複SHRE𝚈ASH',
            'XOSZ',
            'ΔKHIL',
            'H ム D i',
            'ＬＡＲＡ＇シ',
            '◤DEVENDRA ◢',
            '彡Oɴʟʏ 々GOAT彡',
            '𝐊ᴀᴡ𝐬ᴀʀ ',
            '亗 𝙵 𝙰 𝚁 𝙼 𝙴 𝚁__❤',
            '༺Saksham༻',
            '♛DONATO♛',
            'এ ⁞ㅤᴀɴ፝֟ᴀ এ'
        ];

        function shuffleArray(array) {
            const arr = [...array];
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        function renderLeaderboard(mode) {
            const container = document.getElementById('leaderboard-rows-container');
            const titleElement = document.getElementById('active-mode-title');
            
            let numberOnePlayer = '';
            let modeTitle = '';

            if (mode === 'br') {
                numberOnePlayer = 'XOSZ';
                modeTitle = 'Free Fire · Battle Royale';
            } else if (mode === 'cs') {
                numberOnePlayer = 'ΔKHIL';
                modeTitle = 'Free Fire · Clash Squad';
            } else if (mode === 'lw') {
                numberOnePlayer = '複SHRE𝚈ASH';
                modeTitle = 'Free Fire · Lone Wolf';
            }

            if (titleElement) titleElement.textContent = modeTitle;

            // Filter out the guaranteed #1 player from the pool for remaining ranks
            const remainingPool = playerPool.filter(p => p !== numberOnePlayer);
            const shuffledPool = shuffleArray(remainingPool).slice(0, 9);

            // Construct Top 10 List
            const top10 = [numberOnePlayer, ...shuffledPool];

            // Base coins above 2000
            let startCoins = 2950;

            let htmlHTML = '';

            top10.forEach((player, index) => {
                const rank = index + 1;
                const coins = (startCoins - (index * 85)).toLocaleString();

                htmlHTML += `
                    <div class="leaderboard-row">
                        <span class="font-black text-slate-900 text-sm">${rank}</span>
                        <span class="font-bold text-slate-900">${player}</span>
                        <span class="xp-text text-right">${coins}</span>
                    </div>
                `;

                // Add Dashed Top 3 Divider
                if (rank === 3) {
                    htmlHTML += `
                        <div class="py-3 px-4 flex items-center gap-3">
                            <div class="h-px bg-slate-300 flex-1 border-t border-dashed border-slate-400"></div>
                            <span class="font-ewc text-[10px] font-black tracking-widest text-slate-500 uppercase">LEADERBOARD TOP 3</span>
                            <div class="h-px bg-slate-300 flex-1 border-t border-dashed border-slate-400"></div>
                        </div>
                    `;
                }
            });

            container.innerHTML = htmlHTML;
        }

        function selectGameMode(mode) {
            currentMode = mode;
            document.querySelectorAll('.game-card').forEach(card => card.classList.remove('active'));
            document.getElementById(`mode-${mode}`).classList.add('active');
            renderLeaderboard(mode);
        }

        function switchPickemTab(targetTab) {
            document.querySelectorAll('.tab-item').forEach(btn => btn.classList.remove('active'));
            
            document.getElementById('view-global').classList.add('hidden');
            document.getElementById('view-all-matches').classList.add('hidden');
            document.getElementById('view-tournament').classList.add('hidden');
            document.getElementById('view-recents').classList.add('hidden');

            const activeBtn = document.getElementById(`tab-${targetTab}`);
            if (activeBtn) activeBtn.classList.add('active');

            const activeView = document.getElementById(`view-${targetTab}`);
            if (activeView) activeView.classList.remove('hidden');
        }

        // Initialize with default Battle Royale mode
        window.addEventListener('DOMContentLoaded', () => {
            renderLeaderboard('br');
        });
    </script>

